{
  lib,
  stdenvNoCC,
  runCommand,
  bash,
  fish,
  zsh,
  nixbits,
}:
stdenvNoCC.mkDerivation {
  name = "rex-completions";

  __structuredAttrs = true;

  zshCompletion = ''
    #compdef rex
    (( $+commands[rex] )) || return 1
    eval "$(rex completion zsh)"
    _rex "$@"
  '';

  fishCompletion = ''
    command -q rex; and rex completion fish | source
  '';

  bashCompletion = ''
    command -v rex >/dev/null && eval "$(rex completion bash)"
  '';

  buildCommand = ''
    mkdir -p $out/share/zsh/site-functions $out/share/fish/vendor_completions.d $out/share/bash-completion/completions
    echo -n "$zshCompletion" >$out/share/zsh/site-functions/_rex
    echo -n "$fishCompletion" >$out/share/fish/vendor_completions.d/rex.fish
    echo -n "$bashCompletion" >$out/share/bash-completion/completions/rex
  '';

  passthru.tests = {
    syntax =
      runCommand "test-rex-completions-syntax"
        {
          nativeBuildInputs = [
            bash
            fish
            zsh
          ];
        }
        ''
          share="${nixbits.rex-completions}/share"
          zsh -n "$share/zsh/site-functions/_rex"
          fish --no-execute "$share/fish/vendor_completions.d/rex.fish"
          bash -n "$share/bash-completion/completions/rex"
          touch $out
        '';

    without-rex = runCommand "test-rex-completions-without-rex" { } ''
      completion="${nixbits.rex-completions}/share/bash-completion/completions/rex"
      output="$(PATH=/var/empty ${lib.getExe bash} -c "source $completion; echo ok")"
      if [[ "$output" != "ok" ]]; then
        echo "expected 'ok' but was '$output'"
        return 1
      fi
      touch $out
    '';
  };

  meta = {
    description = "Shell completions for the Rex CLI, generated by the installed rex on first use";
    license = lib.licenses.mit;
    platforms = lib.platforms.all;
  };
}
